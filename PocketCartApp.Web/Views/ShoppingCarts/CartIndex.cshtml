@using PocketCartApp.Domain.DTO
@model ShoppingCartDTO

<h2>Cart</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Total</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Products)
        {
            <tr>
                <td>@item.Product?.ProductName</td>
                <td>@item.Product?.ProductPrice</td>
                <td>@item.quantity</td>
                <td>
                    @(item.quantity * (item.Product?.ProductPrice ?? 0))
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    <button type="button"
            class="btn btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#barcodeModal">
        Enter Barcode
    </button>
</div>

<hr />

<h3>
    Total:
    @Model.Products.Sum(x => x.quantity * (x.Product?.ProductPrice ?? 0))
</h3>

<div class="mt-3">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mt-2">
            @TempData["Error"]
        </div>
    }
    <a asp-action="Checkout" class="btn btn-success">
        Checkout 
    </a>

    <button type="button"
            class="btn btn-danger"
            data-bs-toggle="modal"
            data-bs-target="#clearCartModal">
        Clear Cart
    </button>
</div>

<div class="modal fade" id="barcodeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form asp-action="AddByBarcode" asp-controller="Products" method="post">

                <div class="modal-header">
                    <h5 class="modal-title">Enter EAN-13 Barcode</h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="text"
                           name="barcode"
                           class="form-control"
                           maxlength="13"
                           min="13"
                           pattern="[0-9]{13}"
                           placeholder="Enter barcode..."
                           required />
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-success">
                        Add Product
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

<div class="modal fade" id="clearCartModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form asp-action="ClearCart" method="post">

                <div class="modal-header">
                    <h5 class="modal-title">Confirm Cart Clear</h5>
                </div>

                <div class="modal-body">

                    <label>Enter your Cashier ID</label>

                    <input type="text"
                           name="cashierCode"
                           class="form-control"
                           required />

                </div>

                <div class="modal-footer">
                    <button type="submit"
                            class="btn btn-danger">
                        Clear Cart
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>