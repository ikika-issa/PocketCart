@using PocketCartApp.Domain.DTO
@model ShoppingCartDTO

<h2>Cart</h2>

<div class="products-card mb-4">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Barcode</th>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.ProductsInCart)
            {
                <tr>
                    <td>@item.Product?.Barcode</td>
                    <td>@item.Product?.ProductName</td>
                    <td>@item.UnitPrice</td>
                    <td class="editable-cart-quantity"
                        data-product-id="@item.Product!.Id"
                        data-max="@item.Product.quantity">
                        @item.quantity
                    </td>

                    <td>
                        @(item.quantity * (item.Product?.ProductPrice ?? 0))
                    </td>
                </tr>
            }
            <tr class="empty-barcode-row">
                <td class="barcode-input-cell">
                    
                </td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
        </tbody>
    </table>
</div>

<div class="row">
    <div class="col-lg-7 mb-4">
        <div class="card bg-glass text-white shadow-lg overflow-hidden border-0 rounded-4">
            <div class="card-header bg-dark-gradient border-0 d-flex align-items-center justify-content-between p-3">
                <h5 class="m-0 fw-bold d-flex align-items-center">
                    <span class="status-indicator me-2 status-disconnected" id="statusDot"></span>
                    ESP32-CAM Stream
                </h5>
                <span class="badge bg-secondary rounded-pill px-3 py-2" id="statusText">Disconnected</span>
            </div>

            <div class="card-body bg-dark text-center position-relative p-0 d-flex justify-content-center align-items-center" style="min-height: 360px;">
                <!-- MJPEG Stream Container -->
                <div class="stream-wrapper position-relative" id="streamWrapper">
                    <img id="mjpeg-stream" src="" crossorigin="anonymous" class="img-fluid d-none" alt="ESP32-CAM Feed" style="max-height: 480px; width: auto;" />
                    <div class="scan-laser" id="scanLaser"></div>
                </div>

                <!-- Placeholder when disconnected -->
                <div class="placeholder-feed text-center text-muted" id="placeholderFeed">
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-camera-video-off-fill mb-3" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M10.961 12.365a1.99 1.99 0 0 0 .522-1.103l3.11 1.382A1 1 0 0 0 16 11.731V4.269a1 1 0 0 0-1.406-.913l-3.111 1.382A2 2 0 0 0 9.5 3H4.272l6.69 9.365zm-10.114-9A2.001 2.001 0 0 0 0 5v6a2 2 0 0 0 2 2h5.728L.847 3.366zm9.746 9.025L1.452 2.355 2.158 1.65l9.141 9.035-.712.705z" />
                    </svg>
                    <p class="fs-5">Feed is inactive. Configure IP and Connect.</p>
                </div>
            </div>
        </div>
     </div>

    <div class="col-lg-5 mb-4">
        <h3>
            Total:
            @Model.ProductsInCart.Sum(x => x.quantity * (x.Product?.ProductPrice ?? 0))
            MKD
        </h3>

        <div class="mt-3">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger mt-2">
                    @TempData["Error"]
                </div>
            }
            <a asp-action="Checkout" class="btn btn-success" disabled="@(!Model.ProductsInCart.Any())">
                Checkout
            </a>

            <button type="button"
                    class="btn btn-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#clearCartModal"
                    disabled="@(!Model.ProductsInCart.Any())">
                Clear Cart
            </button>
        </div>
    </div>
</div>

<hr />



<div class="modal fade" id="barcodeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form asp-action="AddByBarcode" asp-controller="Products" method="post">

                <div class="modal-header">
                    <h5 class="modal-title">Enter EAN-13 Barcode</h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="text"
                           name="barcode"
                           class="form-control"
                           maxlength="13"
                           min="13"
                           pattern="[0-9]{13}"
                           placeholder="Enter barcode..."
                           required />
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-success">
                        Add Product
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

<div class="modal fade" id="clearCartModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form asp-action="ClearCart" method="post">

                <div class="modal-header">
                    <h5 class="modal-title">Confirm Cart Clear</h5>
                </div>

                <div class="modal-body">

                    <label>Enter your Cashier ID</label>

                    <input type="text"
                           name="cashierCode"
                           class="form-control"
                           required />
                </div>

                <div class="modal-footer">
                    <button type="submit"
                            class="btn btn-danger">
                        Clear Cart
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Context.Request.Query.ContainsKey("receiptId"))
{
    var receiptId = Context.Request.Query["receiptId"].ToString();
    var pdfPath = $"/receipts/Receipt-{receiptId}.pdf";

    <div class="modal fade" id="receiptPrintedModal" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content rounded-4">

                <div class="modal-header">
                    <h5 class="modal-title">Receipt printed</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <p class="mb-3">Receipt was successfully created and printed.</p>

                    <iframe src="@pdfPath"
                            width="100%"
                            height="600"
                            style="border:none;">
                    </iframe>
                </div>

                <div class="modal-footer">
                    <a href="@pdfPath"
                       target="_blank"
                       class="btn btn-success">
                        Open PDF
                    </a>

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Close
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@section Scripts {
    @* TO PRINT RECEIPTS *@
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modalElement = document.getElementById("receiptPrintedModal");

            if (modalElement) {
                const modal = new bootstrap.Modal(modalElement);
                modal.show();
            }
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            document.addEventListener("dblclick", function (e) {

                const cell = e.target.closest(".barcode-input-cell");

                if (!cell) return;

                if (cell.querySelector("input")) return;

                const oldText = cell.innerText.trim();

                const input = document.createElement("input");
                input.type = "text";
                input.maxLength = 13;
                input.placeholder = "Enter barcode";
                input.className = "form-control form-control-sm";

                cell.innerHTML = "";
                cell.appendChild(input);
                input.focus();

                function save() {

                    const barcode = input.value.trim();
                    console.log("Barcode:", barcode);


                    if (!/^\d{13}$/.test(barcode)) {
                        cell.innerText = oldText;
                        alert("Please enter a valid 13-digit barcode.");
                        return;
                    }

                    fetch("/Products/AddByBarcode", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded"
                        },
                        body: `barcode=${encodeURIComponent(barcode)}`
                    })
                    .then(response => {
                        if (response.ok) {
                            window.location.href = "/ShoppingCarts/CartIndex";
                        } else {
                            cell.innerText = oldText;
                            alert("Product not found.");
                        }
                    })
                    .catch(error => {
                        console.error(error);
                        cell.innerText = oldText;
                        alert("Error while adding product.");
                    });
                }

                input.addEventListener("keydown", function (e) {

                    if (e.key === "Enter") {
                        e.preventDefault();
                        save();
                    }

                    if (e.key === "Escape") {
                        cell.innerText = oldText;
                    }
                });

            });
        });
    </script>

    <script>
        document.addEventListener("dblclick", function (e) {
            const cell = e.target.closest(".editable-cart-quantity");

            if (!cell) return;
            if (cell.querySelector("input")) return;

            const oldValue = cell.innerText.trim();
            const productId = cell.dataset.productId;
            const max = cell.dataset.max;

            const input = document.createElement("input");
            input.type = "number";
            input.min = "0";
            input.max = max;
            input.step = "1";
            input.value = oldValue;
            input.className = "form-control form-control-sm";

            cell.innerHTML = "";
            cell.appendChild(input);
            input.focus();

            if (parseFloat(input.value) > parseFloat(max))
            {
                alert(`Only ${max} items available in stock.`);
                input.value = max;
                return;
            }

            function save() {
                     let newQuantity = parseFloat(input.value);
                    const maxQuantity = parseFloat(cell.dataset.max);

                    if (newQuantity > maxQuantity) {
                        alert(`Only ${maxQuantity} items are available in stock.`);
                        newQuantity = maxQuantity;
                        input.value = maxQuantity;
                    }

                    if (newQuantity < 0 || isNaN(newQuantity)) {
                        newQuantity = 0;
                    }


                fetch("/ShoppingCarts/UpdateCartQuantity", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded"
                    },
                    body: `productId=${encodeURIComponent(productId)}&quantity=${encodeURIComponent(newQuantity)}`
                })
                .then(response => {
                    if (response.ok) {
                        location.reload();
                    } else {
                        cell.innerText = oldValue;
                        alert("Quantity update failed.");
                    }
                })
                .catch(() => {
                    cell.innerText = oldValue;
                    alert("Error while updating quantity.");
                });
            }

            input.addEventListener("keydown", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    save();
                }

                if (e.key === "Escape") {
                    cell.innerText = oldValue;
                }
            });
        });
    </script>
}