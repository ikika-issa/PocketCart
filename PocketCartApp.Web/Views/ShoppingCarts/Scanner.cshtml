@{
    ViewData["Title"] = "Supermarket Scanner";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="scanner-container py-4">
    <div class="row">
        <!-- Left: Live stream and connection info -->
        <div class="col-lg-7 mb-4">
            <div class="card bg-glass text-white shadow-lg overflow-hidden border-0 rounded-4">
                <div class="card-header bg-dark-gradient border-0 d-flex align-items-center justify-content-between p-3">
                    <h5 class="m-0 fw-bold d-flex align-items-center">
                        <span class="status-indicator me-2 status-disconnected" id="statusDot"></span>
                        ESP32-CAM Stream
                    </h5>
                    <span class="badge bg-secondary rounded-pill px-3 py-2" id="statusText">Disconnected</span>
                </div>
                
                <div class="card-body bg-dark text-center position-relative p-0 d-flex justify-content-center align-items-center" style="min-height: 360px;">
                    <!-- MJPEG Stream Container -->
                    <div class="stream-wrapper position-relative" id="streamWrapper">
                        <img id="mjpeg-stream" src="" crossorigin="anonymous" class="img-fluid d-none" alt="ESP32-CAM Feed" style="max-height: 480px; width: auto;" />
                        <div class="scan-laser" id="scanLaser"></div>
                    </div>
                    
                    <!-- Placeholder when disconnected -->
                    <div class="placeholder-feed text-center text-muted" id="placeholderFeed">
                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-camera-video-off-fill mb-3" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M10.961 12.365a1.99 1.99 0 0 0 .522-1.103l3.11 1.382A1 1 0 0 0 16 11.731V4.269a1 1 0 0 0-1.406-.913l-3.111 1.382A2 2 0 0 0 9.5 3H4.272l6.69 9.365zm-10.114-9A2.001 2.001 0 0 0 0 5v6a2 2 0 0 0 2 2h5.728L.847 3.366zm9.746 9.025L1.452 2.355 2.158 1.65l9.141 9.035-.712.705z"/>
                        </svg>
                        <p class="fs-5">Feed is inactive. Configure IP and Connect.</p>
                    </div>
                </div>
                
                <div class="card-footer bg-glass-dark border-0 p-3">
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-0 text-white">ESP32 IP / Stream URL</span>
                        <input type="text" class="form-control bg-dark border-0 text-white" id="camUrl" placeholder="e.g. 192.168.1.100 or http://192.168.1.100/stream" />
                        <button class="btn btn-primary px-4" id="btnConnect">Connect</button>
                    </div>
                    <small class="text-muted mt-2 d-block">Make sure your ESP32-CAM is powered and on the same Wi-Fi network.</small>
                </div>
            </div>

            <!-- Debug Panel -->
            <div class="card bg-glass shadow-lg border-0 rounded-4 mt-4" id="debugPanel">
                <div class="card-header bg-dark text-white border-0 p-3 rounded-top-4 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 fw-bold">Scan Debug & Performance</h6>
                    <div class="form-check form-switch m-0">
                        <input class="form-check-input" type="checkbox" id="enableFilters" checked />
                        <label class="form-check-label text-white-50 fs-7" for="enableFilters">Image Filters</label>
                    </div>
                </div>
                <div class="card-body p-3">
                    <div class="row">
                        <div class="col-md-6 mb-3 mb-md-0 text-center">
                            <span class="d-block text-muted fs-7 mb-2">Processed Scanner Canvas Frame:</span>
                            <div class="debug-canvas-wrapper border rounded bg-dark p-1 d-inline-block" style="max-width: 100%;">
                                <canvas id="debug-canvas-preview" style="max-width: 100%; height: auto; display: block; max-height: 180px;"></canvas>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <span class="d-block text-muted fs-7 mb-2">Performance & Logs:</span>
                            <ul class="list-group list-group-flush fs-7 bg-transparent">
                                <li class="list-group-item bg-transparent d-flex justify-content-between p-1 border-0">
                                    <span>Frames Processed:</span>
                                    <span class="fw-bold" id="debugFramesCount">0</span>
                                </li>
                                <li class="list-group-item bg-transparent d-flex justify-content-between p-1 border-0">
                                    <span>Quagga Result:</span>
                                    <span class="fw-bold text-truncate" style="max-width: 150px;" id="debugLastResult">None</span>
                                </li>
                                <li class="list-group-item bg-transparent d-flex justify-content-between p-1 border-0">
                                    <span>Scan Rate:</span>
                                    <span class="fw-bold" id="debugRate">3 frames/sec</span>
                                </li>
                                <li class="list-group-item bg-transparent p-1 border-0 text-muted">
                                    <small id="debugTip">Tip: Hold barcode flat and parallel to camera. Align red lines with scan center.</small>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Right: Recent scan log & cart controls -->
        <div class="col-lg-5 mb-4">
            <!-- Last Scanned Card -->
            <div class="card bg-glass border-0 shadow-lg rounded-4 mb-4" id="lastScannedCard">
                <div class="card-body p-4 text-center">
                    <span class="text-uppercase text-muted fs-7 letter-spacing-1 d-block mb-1">Last Scanned Item</span>
                    <h3 class="fw-bold m-0 text-primary" id="lastProductName">-</h3>
                    <div class="d-flex justify-content-center gap-3 my-3">
                        <div class="badge bg-light text-dark border px-3 py-2" id="lastBarcode">-</div>
                        <div class="badge bg-success text-white px-3 py-2 fs-6" id="lastPrice">-</div>
                    </div>
                    <div class="scan-status-message text-muted fs-7" id="scanMessage">Ready to scan...</div>
                </div>
            </div>
            
            <!-- Scanning History Log -->
            <div class="card bg-glass border-0 shadow-lg rounded-4">
                <div class="card-header bg-glass border-0 d-flex justify-content-between align-items-center p-3">
                    <h5 class="fw-bold m-0 text-dark">Session History</h5>
                    <button class="btn btn-outline-danger btn-sm rounded-pill px-3" id="btnClearHistory">Clear Log</button>
                </div>
                
                <div class="card-body p-0">
                    <div class="history-list overflow-auto p-3" style="max-height: 250px;" id="historyContainer">
                        <div class="empty-history text-center text-muted py-4" id="emptyHistoryText">
                            <p class="m-0">Scanned items will appear here.</p>
                        </div>
                    </div>
                </div>
                
                <div class="card-footer bg-light border-0 p-4 rounded-bottom-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fs-5 text-muted">Running Total:</span>
                        <span class="fs-2 fw-bold text-success" id="runningTotal">0.00 MKD</span>
                    </div>
                    
                    <div class="d-grid gap-2">
                        <a asp-action="CartIndex" class="btn btn-success btn-lg rounded-3 fw-bold py-3 shadow-sm d-flex align-items-center justify-content-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-cart-check-fill me-2" viewBox="0 0 16 16">
                                <path d="M.5 1a.5.5 0 0 0 0 1h1.11l.401 1.607 1.498 7.985A.5.5 0 0 0 4 12h1a2 2 0 1 0 0 4 2 2 0 0 0 0-4h7a2 2 0 1 0 0 4 2 2 0 0 0 0-4h1a.5.5 0 0 0 .491-.408l1.5-8A.5.5 0 0 0 14.5 3H2.89l-.405-1.621A.5.5 0 0 0 2 1H.5zM6 14a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm7 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm-1.646-7.646-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L8 8.293l2.646-2.647a.5.5 0 0 1 .708.708z"/>
                            </svg>
                            Go to Cart & Checkout
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hidden canvas used for grabbing frames from img stream -->
<canvas id="canvas-grab" style="display: none;"></canvas>

<!-- Styling for premium layout and interactive components -->
<style>
    .bg-glass {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }
    
    .bg-glass-dark {
        background: rgba(33, 37, 41, 0.85);
        backdrop-filter: blur(10px);
    }
    
    .bg-dark-gradient {
        background: linear-gradient(135deg, #1f2124 0%, #111215 100%);
    }

    .status-indicator {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        display: inline-block;
        box-shadow: 0 0 8px currentColor;
    }
    
    .status-disconnected {
        background-color: #dc3545;
        color: #dc3545;
    }
    
    .status-connecting {
        background-color: #ffc107;
        color: #ffc107;
        animation: pulse-warn 1.5s infinite;
    }
    
    .status-scanning {
        background-color: #198754;
        color: #198754;
        animation: pulse-success 1.5s infinite;
    }

    @@keyframes pulse-warn {
        0% { box-shadow: 0 0 0 0 rgba(255, 193, 7, 0.7); }
        70% { box-shadow: 0 0 0 10px rgba(255, 193, 7, 0); }
        100% { box-shadow: 0 0 0 0 rgba(255, 193, 7, 0); }
    }
    
    @@keyframes pulse-success {
        0% { box-shadow: 0 0 0 0 rgba(25, 135, 84, 0.7); }
        70% { box-shadow: 0 0 0 10px rgba(25, 135, 84, 0); }
        100% { box-shadow: 0 0 0 0 rgba(25, 135, 84, 0); }
    }

    /* Laser scan line overlay effect */
    .scan-laser {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(to right, rgba(0,255,0,0) 0%, rgba(0,255,0,1) 50%, rgba(0,255,0,0) 100%);
        box-shadow: 0 0 12px #0f0;
        z-index: 10;
        display: none;
        animation: laser-anim 2.5s linear infinite;
    }

    @@keyframes laser-anim {
        0% { top: 0%; }
        50% { top: 100%; }
        100% { top: 0%; }
    }

    .history-item {
        border-left: 4px solid #198754;
        transition: transform 0.2s;
    }
    
    .history-item:hover {
        transform: translateX(4px);
    }
    
    .letter-spacing-1 {
        letter-spacing: 1.5px;
    }
    
    .fs-7 {
        font-size: 0.8rem;
    }
</style>

@section Scripts {
    <!-- Load Quagga2 Barcode Reader from CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@@ericblade/quagga2/dist/quagga.min.js"></script>
    <script>
        let isConnected = false;
        let scanInterval = null;
        let runningTotal = 0;
        let lastScannedBarcode = "";
        let lastScanTime = 0;
        let debugFramesCount = 0;
        const COOLDOWN_MS = 2500; // 2.5 seconds cooldown to prevent rapid duplicates

        const imgStream = document.getElementById("mjpeg-stream");
        const camUrlInput = document.getElementById("camUrl");
        const btnConnect = document.getElementById("btnConnect");
        const statusDot = document.getElementById("statusDot");
        const statusText = document.getElementById("statusText");
        const placeholderFeed = document.getElementById("placeholderFeed");
        const scanLaser = document.getElementById("scanLaser");
        
        // Load stored ESP32 IP/URL if it exists
        const storedUrl = localStorage.getItem("pc-cam-url");
        if (storedUrl) {
            camUrlInput.value = storedUrl;
        } else {
            camUrlInput.value = "http://192.168.1.100/stream"; // Default suggestion
        }

        // Web Audio API Synthesized beep (Checkout scanner sound)
        function playBeepSound() {
            try {
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const oscillator = audioCtx.createOscillator();
                const gainNode = audioCtx.createGain();

                oscillator.connect(gainNode);
                gainNode.connect(audioCtx.destination);

                oscillator.type = 'sine';
                oscillator.frequency.setValueAtTime(1200, audioCtx.currentTime); // 1200 Hz
                gainNode.gain.setValueAtTime(0.08, audioCtx.currentTime);

                oscillator.start();
                setTimeout(() => {
                    oscillator.stop();
                    audioCtx.close();
                }, 120); // 120ms beep
            } catch (err) {
                console.error("Audio Context beep failed", err);
            }
        }

        btnConnect.addEventListener("click", function () {
            if (isConnected) {
                disconnectCamera();
            } else {
                connectCamera();
            }
        });

        function connectCamera() {
            let urlVal = camUrlInput.value.trim();
            if (!urlVal) {
                alert("Please enter a valid IP address or Stream URL.");
                return;
            }

            // Ensure format includes protocol
            if (!urlVal.startsWith("http://") && !urlVal.startsWith("https://")) {
                urlVal = "http://" + urlVal;
            }

            // If it is just an IP, suffix with /stream
            if (urlVal.split("/").length === 3) {
                urlVal = urlVal + "/stream";
            }

            localStorage.setItem("pc-cam-url", camUrlInput.value.trim());

            // Set state to connecting
            isConnected = false;
            statusDot.className = "status-indicator me-2 status-connecting";
            statusText.innerText = "Connecting...";
            statusText.className = "badge bg-warning text-dark rounded-pill px-3 py-2";
            btnConnect.disabled = true;

            // Try to load the image stream
            imgStream.crossOrigin = "anonymous";
            imgStream.src = urlVal;
            imgStream.onload = function() {
                // Connection successful!
                isConnected = true;
                btnConnect.disabled = false;
                btnConnect.innerText = "Disconnect";
                btnConnect.className = "btn btn-danger px-4";
                statusDot.className = "status-indicator me-2 status-scanning";
                statusText.innerText = "Scanning";
                statusText.className = "badge bg-success text-white rounded-pill px-3 py-2";
                placeholderFeed.classList.add("d-none");
                imgStream.classList.remove("d-none");
                scanLaser.style.display = "block";

                // Start periodic frame grabbing
                startScanning();
            };

            imgStream.onerror = function() {
                // Connection failed
                alert("Failed to connect to the ESP32-CAM stream. Check IP/URL and ensure the device is streaming.");
                disconnectCamera();
            };
        }

        function disconnectCamera() {
            isConnected = false;
            stopScanning();
            imgStream.src = "";
            imgStream.classList.add("d-none");
            placeholderFeed.classList.remove("d-none");
            scanLaser.style.display = "none";
            
            btnConnect.disabled = false;
            btnConnect.innerText = "Connect";
            btnConnect.className = "btn btn-primary px-4";
            statusDot.className = "status-indicator me-2 status-disconnected";
            statusText.innerText = "Disconnected";
            statusText.className = "badge bg-secondary rounded-pill px-3 py-2";
        }

        function startScanning() {
            if (scanInterval) clearInterval(scanInterval);
            scanInterval = setInterval(grabAndScanFrame, 330); // Grab frame ~3 times per second
        }

        function stopScanning() {
            if (scanInterval) {
                clearInterval(scanInterval);
                scanInterval = null;
            }
        }

        function grabAndScanFrame() {
            if (!isConnected) return;

            const canvas = document.getElementById("canvas-grab");
            const ctx = canvas.getContext("2d");
            const debugCanvas = document.getElementById("debug-canvas-preview");
            const debugCtx = debugCanvas ? debugCanvas.getContext("2d") : null;
            const enableFilters = document.getElementById("enableFilters")?.checked;

            // Match canvas size to the natural size of the loaded image stream
            if (imgStream.naturalWidth > 0) {
                canvas.width = imgStream.naturalWidth;
                canvas.height = imgStream.naturalHeight;
            } else {
                canvas.width = 640;
                canvas.height = 480;
            }

            // Set debug canvas size to match
            if (debugCanvas) {
                debugCanvas.width = canvas.width;
                debugCanvas.height = canvas.height;
            }

            // Apply high-contrast black & white filter to boost barcode recognition!
            if (enableFilters) {
                ctx.filter = "grayscale(100%) contrast(175%) brightness(105%)";
            } else {
                ctx.filter = "none";
            }

            // Draw image frame to hidden canvas
            try {
                ctx.drawImage(imgStream, 0, 0, canvas.width, canvas.height);
                
                // Draw the same frame onto the visible debug canvas so the user sees what the scanner is reading
                if (debugCtx) {
                    debugCtx.drawImage(canvas, 0, 0);
                }

                const dataUrl = canvas.toDataURL("image/jpeg");

                // Update processed frame counter
                debugFramesCount++;
                const framesSpan = document.getElementById("debugFramesCount");
                if (framesSpan) framesSpan.innerText = debugFramesCount;

                // Call Quagga2 decode single frame
                Quagga.decodeSingle({
                    src: dataUrl,
                    numOfWorkers: 0,
                    locate: true,
                    decoder: {
                        readers: ["ean_reader"] // Focus on EAN-13 reader used by our app barcodes
                    },
                    locator: {
                        patchSize: "medium",
                        halfSample: true
                    }
                }, function (result) {
                    const resultSpan = document.getElementById("debugLastResult");
                    if (result && result.codeResult && result.codeResult.code) {
                        const barcode = result.codeResult.code;
                        if (resultSpan) {
                            resultSpan.innerText = barcode;
                            resultSpan.className = "fw-bold text-success";
                        }
                        onBarcodeFound(barcode);
                    } else {
                        if (resultSpan) {
                            resultSpan.innerText = "No barcode";
                            resultSpan.className = "fw-bold text-muted";
                        }
                    }
                });
            } catch (err) {
                document.getElementById("scanMessage").innerHTML = `<span class="text-danger">Frame grab error: ${err.message}</span>`;
                console.error("Frame draw error:", err);
            }
        }

        function onBarcodeFound(barcode) {
            const now = Date.now();
            // Prevent immediate duplicate scans
            if (barcode === lastScannedBarcode && (now - lastScanTime) < COOLDOWN_MS) {
                return;
            }

            lastScannedBarcode = barcode;
            lastScanTime = now;

            // Trigger checkout beep sound
            playBeepSound();

            document.getElementById("scanMessage").innerText = "Processing barcode " + barcode + "...";
            document.getElementById("lastBarcode").innerText = barcode;
            
            // Post barcode to API to add to cart
            fetch("/Products/AddByBarcodeAjax", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]')?.value || ""
                },
                body: JSON.stringify({ barcode: barcode })
            })
            .then(async (response) => {
                const data = await response.json();
                if (response.ok && data.success) {
                    // Update Last Scanned UI
                    document.getElementById("lastProductName").innerText = data.productName;
                    document.getElementById("lastPrice").innerText = data.price.toFixed(2) + " MKD";
                    document.getElementById("scanMessage").innerHTML = `<span class="text-success fw-bold">Added successfully!</span>`;
                    
                    // Add item to history log list
                    addToHistory(data.productName, barcode, data.price);
                    
                    // Update total price display
                    runningTotal += data.price;
                    document.getElementById("runningTotal").innerText = runningTotal.toFixed(2) + " MKD";
                } else {
                    document.getElementById("scanMessage").innerHTML = `<span class="text-danger fw-bold">Error: ${data.message || "Failed to add"}</span>`;
                }
            })
            .catch((error) => {
                document.getElementById("scanMessage").innerHTML = `<span class="text-danger fw-bold">Network error while adding product.</span>`;
                console.error(error);
            });
        }

        function addToHistory(name, barcode, price) {
            const container = document.getElementById("historyContainer");
            const emptyText = document.getElementById("emptyHistoryText");
            if (emptyText) emptyText.remove();

            const itemDiv = document.createElement("div");
            itemDiv.className = "history-item bg-white p-3 rounded-3 shadow-sm mb-2 d-flex justify-content-between align-items-center";
            
            const timestamp = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            
            itemDiv.innerHTML = `
                <div>
                    <h6 class="fw-bold mb-0 text-dark">${name}</h6>
                    <small class="text-muted">Barcode: ${barcode} | Time: ${timestamp}</small>
                </div>
                <span class="badge bg-light text-success border border-success px-2 py-1 fw-bold">+${price.toFixed(2)} MKD</span>
            `;
            
            // Prepend so latest items are at the top
            container.insertBefore(itemDiv, container.firstChild);
        }

        document.getElementById("btnClearHistory").addEventListener("click", function() {
            const container = document.getElementById("historyContainer");
            container.innerHTML = `
                <div class="empty-history text-center text-muted py-4" id="emptyHistoryText">
                    <p class="m-0">Scanned items will appear here.</p>
                </div>
            `;
            runningTotal = 0;
            document.getElementById("runningTotal").innerText = "0.00 MKD";
            document.getElementById("lastProductName").innerText = "-";
            document.getElementById("lastBarcode").innerText = "-";
            document.getElementById("lastPrice").innerText = "-";
            document.getElementById("scanMessage").innerText = "Log cleared. Ready to scan...";
        });
    </script>
}
