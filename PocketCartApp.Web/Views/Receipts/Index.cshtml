@model IEnumerable<PocketCartApp.Domain.Domain_Models.Receipt>

@{
    ViewData["Title"] = "Receipts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Receipts</h2>
    </div>
</div>

<div class="products-card">
    <table class="table">
        <thead>
            <tr>
                <th>
                    Cashier username
                </th>
                <th>
                    Date
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.total)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.currency)
                </th>
                <th>PDF</th>
            </tr>
            <tr class="filters">
                <th><input class="form-control form-control-sm" placeholder="Search cashier" /></th>
                <th><input class="form-control form-control-sm" placeholder="Search date" /></th>
                <th><input class="form-control form-control-sm" placeholder="Search total" /></th>
                <th><input class="form-control form-control-sm" placeholder="Search currency" /></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model) {
            var pdfPath = $"/receipts/Receipt-{item.Id}.pdf";

            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.ShoppingCart.Cashier.UserName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PaidAt)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.total)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.currency)
                </td>
                <td>
                    <a href="@pdfPath"
                       target="_blank"
                       class="btn btn-outline-success btn-sm">
                        View PDF
                    </a>
                </td>
            </tr>
    }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const table = $('#receiptsTable').DataTable({
                orderCellsTop: true
            });

            $('.filters th').each(function (index) {
                const input = $(this).find('input');

                if (input.length) {
                    input.on('keyup change clear', function () {
                        table.column(index).search(this.value).draw();
                    });
                }
            });
        });
    </script>
}