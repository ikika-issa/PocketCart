@using PocketCartApp.Domain.Domain_Models
@model PocketCartApp.Domain.Domain_Models.Deal

<h2>Add Deal</h2>

<div class="products-card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="form-group mb-3">
            <label class="form-label">Title</label>
            <input asp-for="Title" class="form-control" />
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Deal Type</label>
            <select asp-for="DealType" class="form-select" asp-items="Html.GetEnumSelectList<DealType>()">
            </select>
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Main Product</label>
            <select asp-for="ProductId" class="form-select" asp-items="ViewBag.Products">
                <option value="">Select product</option>
            </select>
        </div>

        <div id="discountField" class="form-group mb-3">
            <label class="form-label">Discount Price</label>
            <input asp-for="DiscountPrice" class="form-control" />
        </div>

        <div id="bundleProductField" class="form-group mb-3">
            <label class="form-label">Bundle Product</label>
            <select asp-for="BundleProductId" class="form-select" asp-items="ViewBag.Products">
                <option value="">Select bundle product</option>
            </select>
        </div>

        <div id="bundlePriceField" class="form-group mb-3">
            <label class="form-label">Bundle Price</label>
            <input asp-for="BundlePrice" class="form-control" />
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Start Date</label>
            <input asp-for="StartDate" type="date" class="form-control" />
        </div>

        <div class="form-group mb-3">
            <label class="form-label">End Date</label>
            <input asp-for="EndDate" type="date" class="form-control" />
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">Active</label>
        </div>

        <button type="submit" class="btn btn-success">
            Save Deal
        </button>
    </form>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const dealType = document.getElementById("DealType");

        const discountField = document.getElementById("discountField");
        const bundleProductField = document.getElementById("bundleProductField");
        const bundlePriceField = document.getElementById("bundlePriceField");

        function toggleFields() {
            const selectedValue = dealType.value;

            if (selectedValue === "0") {
                discountField.style.display = "block";
                bundleProductField.style.display = "none";
                bundlePriceField.style.display = "none";
            } else {
                discountField.style.display = "none";
                bundleProductField.style.display = "block";
                bundlePriceField.style.display = "block";
            }
        }

        dealType.addEventListener("change", toggleFields);
        toggleFields();
    });
</script>