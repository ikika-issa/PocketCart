@model IEnumerable<PocketCartApp.Domain.Identity_Models.PocketCartApplicationUser>

<h2>Employees</h2>

<a class="btn btn-primary mb-3"
   asp-area="Identity"
   asp-page="/Account/Register">
    Add New Employee
</a>

<table class="table">
    <thead>
        <tr>
            <th>First name</th>
            <th>Last name</th>
            <th>Username</th>
            <th>Email</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.FirstName</td>
                <td>@employee.LastName</td>
                <td>@employee.UserName</td>
                <td>@employee.Email</td>
                <td>
                    @(employee.LockoutEnd != null && employee.LockoutEnd > DateTimeOffset.Now
                                    ? "Disabled"
                                    : "Active")
            </td>
            <td>
                @if (employee.LockoutEnd != null &&
                                employee.LockoutEnd > DateTimeOffset.Now)
                    {
                        <form asp-action="Enable" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@employee.Id" />

                            <button type="submit" class="btn btn-success btn-sm">
                                Enable Account
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Disable" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@employee.Id" />

                            <button type="submit" class="btn btn-danger btn-sm">
                                Disable Account
                            </button>
                        </form>
                    }
                </td>
            </tr>
                }
    </tbody>
</table>