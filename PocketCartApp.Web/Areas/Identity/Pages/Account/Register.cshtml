@page
@using PocketCartApp.Domain.Domain_Models
@model RegisterModel

@{
    ViewData["Title"] = "Register";
}

<div class="register-page">
    <div class="register-card">

        <div class="text-center mb-4">
            <h2 class="fw-bold mb-1">New Employee</h2>
        </div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"
                 role="alert"></div>

            <div class="form-group mb-4">
                <label asp-for="Input.FirstName" class="form-label">First Name</label>
                <input asp-for="Input.FirstName"
                       class="form-control"
                       autocomplete="off" />
                <span asp-validation-for="Input.FirstName" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Input.LastName" class="form-label">Last Name</label>
                <input asp-for="Input.LastName"
                       class="form-control"
                       autocomplete="off" />
                <span asp-validation-for="Input.LastName" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Input.StartDate" class="form-label">Start Date</label>
                <input asp-for="Input.StartDate"
                       type="date"
                       class="form-control" />
                <span asp-validation-for="Input.StartDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Input.Contract_Type" class="form-label">
                    Contract Type
                </label>

                <select asp-for="Input.Contract_Type"
                        class="form-select"
                        asp-items="Html.GetEnumSelectList<Contract_Type>()">
                </select>

                <span asp-validation-for="Input.Contract_Type" class="text-danger"></span>
            </div>

            <div class="form-group mb-4"
                 id="durationField"
                 style="display:none;">

                <label asp-for="Input.duration" class="form-label">
                    Duration in Months
                </label>

                <input asp-for="Input.duration"
                       class="form-control" />

                <span asp-validation-for="Input.duration" class="text-danger"></span>
            </div>

            <div class="form-group mt-3" id="endDateField" style="display:none;">
                <label class="form-label">End Date</label>
                <input type="text"
                       id="calculatedEndDate"
                       class="form-control"
                       readonly />
            </div>

            <div class="form-group mb-4">
                <label asp-for="Input.Account_Status" class="form-label">
                    Account Status
                </label>

                <select asp-for="Input.Account_Status"
                        class="form-select"
                        asp-items="Html.GetEnumSelectList<Account_Status>()">
                </select>

                <span asp-validation-for="Input.Account_Status" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Input.Role" class="form-label">
                    Role
                </label>

                <select asp-for="Input.Role"
                        class="form-select"
                        asp-items="Model.RolesList">
                    <option value="">Select role</option>
                </select>

                <span asp-validation-for="Input.Role" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Input.Email" class="form-label">Email</label>

                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username" />

                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Input.Password" class="form-label">Password</label>

                <input asp-for="Input.Password"
                       class="form-control"
                       autocomplete="new-password" />

                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label">
                    Confirm Password
                </label>

                <input asp-for="Input.ConfirmPassword"
                       class="form-control"
                       autocomplete="new-password" />

                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button id="registerSubmit"
                    type="submit"
                    class="btn btn-success btn-lg w-100">
                Create Employee
            </button>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const contractType = document.getElementById("Input_Contract_Type");
            const durationInput = document.getElementById("Input_duration");
            const startDateInput = document.getElementById("Input_StartDate");

            const durationField = document.getElementById("durationField");
            const endDateField = document.getElementById("endDateField");
            const calculatedEndDate = document.getElementById("calculatedEndDate");

            function updateFields() {

                const selectedText =
                    contractType.options[contractType.selectedIndex].text;

                if (selectedText === "Fixed") {

                    durationField.style.display = "block";
                    endDateField.style.display = "block";

                    const startDate = startDateInput.value;
                    const duration = parseInt(durationInput.value);

                    if (startDate && !isNaN(duration)) {

                        const date = new Date(startDate);

                        date.setMonth(date.getMonth() + duration);

                        calculatedEndDate.value =
                            date.toLocaleDateString("en-GB");
                    }
                    else {
                        calculatedEndDate.value = "";
                    }
                }
                else {
                    durationField.style.display = "none";
                    endDateField.style.display = "none";
                    calculatedEndDate.value = "";
                }
            }

            contractType.addEventListener("change", updateFields);
            durationInput.addEventListener("input", updateFields);
            startDateInput.addEventListener("change", updateFields);

            updateFields();
        });
    </script>
}