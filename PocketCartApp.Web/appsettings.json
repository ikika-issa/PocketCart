{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=PocketCartAppDatabase;Trusted_Connection=True;MultipleActiveResultSets=true",
    "ApplicationDbContextConnection": "Server=(localdb)\\mssqllocaldb;Database=PocketCartApp.Repository;Trusted_Connection=True;MultipleActiveResultSets=true"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "MailSettings": {
    "SmtpServer": "smtp.mail.yahoo.com",
    "SmtpServerPort": 465,
    "SmtpUserName": "your_yahoo@yahoo.com",
    "SmtpPassword": "your_app_password",
    "SendersName": "PocketCart",
    "EnableSsl": true
  },

  "AllowedHosts": "*"
}